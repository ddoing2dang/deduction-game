  "weaponInstanceRules": {
    "weaponId": "Item TYPE used in answer",
    "instanceId": "Distinct physical copy in an NPC room, required to track traces and access",
    "copyPolicy": "Same weaponId in two rooms denotes distinct physical objects of the same type. Never treat one physical object as simultaneously present in two rooms.",
    "crimeScenePolicy": "Only non-weapon evidence such as marks, residue, records and traces in CRIME_SCENE/LOBBY; no physical weapon instance appears outside 6 NPC personal rooms during investigation.",
    "timelinePolicy": "If a weapon copy was used at the crime scene, a valid case timeline must account for access, transport and return before investigation; otherwise the case is rejected.",
    "evidencePolicy": "Finding a tool alone does not prove it was used, the method or the culprit. Forensic support + NPC knowledge/access + timeline + unique proof graph required."
  },
